{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "palette": [
        { "slug": "primary", "color": "#FF6B35", "name": "Primary Orange" },
        { "slug": "secondary", "color": "#2B7A62", "name": "Secondary Green" },
        { "slug": "accent", "color": "#F9C80E", "name": "Accent Yellow" },
        { "slug": "background", "color": "#FAFAF8", "name": "Background Warm" },
        { "slug": "foreground", "color": "#2D2D2D", "name": "Text Dark" },
        { "slug": "base", "color": "#FFFFFF", "name": "White" }
      ],
      "link": true,
      "gradients": []
    },
    "typography": {
      "fontFamilies": [
        { "slug": "fredoka", "name": "Fredoka", "fontFamily": "\"Fredoka\", system-ui, sans-serif" },
        { "slug": "inter", "name": "Inter", "fontFamily": "\"Inter\", system-ui, sans-serif" },
        { "slug": "system", "name": "System", "fontFamily": "system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "1.75rem", "name": "XL" },
        { "slug": "xx-large", "size": "2.5rem", "name": "XXL" }
      ],
      "dropCap": false
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    },
    "border": {
      "radius": true,
      "color": true,
      "width": true
    },
    "shadow": {
      "presets": [
        { "name": "Soft", "slug": "soft", "shadow": "0 2px 8px rgba(0,0,0,0.08)" },
        { "name": "Medium", "slug": "medium", "shadow": "0 4px 16px rgba(0,0,0,0.12)" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "blocks": {
      "core/button": {
        "border": { "radius": "50px" },
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" },
        "typography": { "fontWeight": "600" },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--secondary)" }
        }
      },
      "core/cover": {
        "border": { "radius": "16px" }
      },
      "core/image": {
        "border": { "radius": "12px" }
      },
      "core/navigation": {
        "typography": { "fontWeight": "500" }
      }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--secondary)" } }
      },
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--fredoka)", "fontWeight": "600" }
      }
    },
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem"
    }
  },
  "customTemplates": [
    { "name": "home", "title": "Homepage", "postTypes": ["page"] },
    { "name": "full-width", "title": "Full Width", "postTypes": ["page"] },
    { "name": "contact", "title": "Contact", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "sidebar", "title": "Sidebar", "area": "sidebar" }
  ]
}
